---
import { navLinks, siteConfig } from '@/config'
import ThemeToggle from './ThemeToggle.astro'

const path = Astro.url.pathname
---

<header
  class="sticky top-0 z-40 border-b border-gray-200 bg-white/80 backdrop-blur-sm dark:border-gray-800 dark:bg-gray-900/80"
>
  <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-4 sm:px-6">
    <a
      href="/blog"
      class="flex items-center gap-2 font-semibold text-gray-900 dark:text-gray-100"
      aria-label={siteConfig.title}
    >
      <span
        class="inline-flex h-8 w-8 items-center justify-center rounded-md bg-primary-600 font-mono text-sm font-bold text-white"
        aria-hidden="true">bk</span
      >
      <span class="text-lg">{siteConfig.title}</span>
    </a>

    <nav class="flex items-center gap-1 text-sm">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'rounded-md px-3 py-2 font-medium transition',
              path.startsWith(link.href)
                ? 'text-primary-600 dark:text-primary-400'
                : 'text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100',
            ]}
          >
            {link.title}
          </a>
        ))
      }
      <ThemeToggle />
    </nav>
  </div>
</header>
