---
import BaseLayout from '@/layouts/BaseLayout.astro'
---

<BaseLayout title="Page not found" noindex>
  <div class="flex flex-col items-center gap-6 py-16 text-center">
    <p class="text-6xl font-extrabold text-primary-600 dark:text-primary-400">404</p>
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">
      This page could not be found.
    </h1>
    <p class="text-gray-600 dark:text-gray-400">
      The link may be outdated, or the page may have moved.
    </p>
    <a
      href="/blog"
      class="rounded-lg bg-primary-600 px-5 py-2.5 font-medium text-white transition hover:bg-primary-700"
    >
      Back to the blog
    </a>
  </div>
</BaseLayout>
