# Giscus comments — https://giscus.app
#
# Copy this file to .env and fill in the values from the giscus configurator.
# These four IDs are public by design (the giscus script receives them in the
# browser), but they live in the environment so a fork can point comments at a
# different repo without touching the source.
#
# On Vercel these are set as Project Environment Variables instead.
# If they are missing, the comment section is omitted and the build logs a warning.

NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPOSITORY_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
