---
import type { GetStaticPaths } from 'astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Tag from '@/components/Tag.astro'
import { excerpt, formatDate, getSortedPosts, postUrl } from '@/lib/posts'
import { siteConfig } from '@/config'

// Tags are already lowercase-kebab in the frontmatter, so they map straight to
// the live /tags/<tag> URLs with no slugification.
export const getStaticPaths = (async () => {
  const posts = await getSortedPosts()
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort()

  return tags.map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }))
}) satisfies GetStaticPaths

const { tag, posts } = Astro.props
---

<BaseLayout
  title={`${tag}`}
  description={`Posts tagged "${tag}" on ${siteConfig.title}`}
  canonical={`/tags/${tag}`}
>
  <div class="space-y-8">
    <div class="space-y-2">
      <p class="text-sm text-gray-500 dark:text-gray-400">
        <a href="/tags" class="hover:underline">Tags</a>
      </p>
      <h1
        class="text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl dark:text-gray-100"
      >
        {tag}
      </h1>
      <p class="text-gray-500 dark:text-gray-400">
        {posts.length}
        {posts.length === 1 ? 'post' : 'posts'}
      </p>
    </div>

    <ul class="divide-y divide-gray-200 dark:divide-gray-800">
      {
        posts.map((post) => (
          <li class="py-6">
            <article class="space-y-2">
              <time
                datetime={post.data.date.toISOString()}
                class="text-sm text-gray-500 dark:text-gray-400"
              >
                {formatDate(post.data.date, siteConfig.locale)}
              </time>
              <h2 class="text-xl font-bold tracking-tight">
                <a
                  href={postUrl(post)}
                  class="text-gray-900 transition hover:text-primary-600 dark:text-gray-100 dark:hover:text-primary-400"
                >
                  {post.data.title}
                </a>
              </h2>
              <div class="flex flex-wrap gap-2">
                {post.data.tags.map((entry) => (
                  <Tag tag={entry} />
                ))}
              </div>
              <p class="text-gray-600 dark:text-gray-400">{excerpt(post)}</p>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
