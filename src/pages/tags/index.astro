---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getTagCounts } from '@/lib/posts'

const tags = await getTagCounts()
---

<BaseLayout title="Tags" description="All tags on Bravo Kernel" canonical="/tags">
  <div class="space-y-8">
    <h1 class="text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl dark:text-gray-100">
      Tags
    </h1>

    <ul class="flex flex-wrap gap-3">
      {
        tags.map(([tag, count]) => (
          <li>
            <a
              href={`/tags/${tag}`}
              class="inline-flex items-center gap-2 rounded-lg border border-gray-200 px-3 py-2 text-sm font-medium text-gray-700 transition hover:border-primary-500 hover:text-primary-700 dark:border-gray-700 dark:text-gray-300 dark:hover:border-primary-500 dark:hover:text-primary-400"
            >
              {tag}
              <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600 dark:bg-gray-800 dark:text-gray-400">
                {count}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
