---
import { siteConfig } from '@/config'

const year = new Date().getFullYear()
---

<footer class="mt-20 border-t border-gray-200 dark:border-gray-800">
  <div
    class="mx-auto flex max-w-3xl flex-col items-center gap-3 px-4 py-10 text-sm text-gray-500 sm:px-6 dark:text-gray-400"
  >
    <div class="flex gap-4">
      <a
        href={siteConfig.github}
        aria-label="GitHub"
        class="transition hover:text-gray-900 dark:hover:text-gray-100"
      >
        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M12 .3a12 12 0 00-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7 0-.7 0-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2 0-.4-.5-1.6.2-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 016 0C17.3 4.6 18.3 5 18.3 5c.7 1.6.2 2.8.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0012 .3"
          ></path>
        </svg>
      </a>
      <a
        href={siteConfig.twitter}
        aria-label="Twitter"
        class="transition hover:text-gray-900 dark:hover:text-gray-100"
      >
        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M23.95 4.57a10 10 0 01-2.83.78 4.96 4.96 0 002.17-2.72c-.95.56-2 .97-3.13 1.2a4.92 4.92 0 00-8.39 4.49A14 14 0 011.64 3.16a4.92 4.92 0 001.52 6.57 4.9 4.9 0 01-2.23-.61v.06a4.92 4.92 0 003.95 4.83 4.95 4.95 0 01-2.22.08 4.93 4.93 0 004.6 3.42A9.87 9.87 0 010 19.54a13.94 13.94 0 007.55 2.21c9.06 0 14-7.5 14-14v-.64c.96-.7 1.8-1.56 2.46-2.54z"
          ></path>
        </svg>
      </a>
      <a
        href="/feed.xml"
        aria-label="RSS feed"
        class="transition hover:text-gray-900 dark:hover:text-gray-100"
      >
        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M6.18 15.64a2.18 2.18 0 012.18 2.18C8.36 19 7.38 20 6.18 20 5 20 4 19 4 17.82a2.18 2.18 0 012.18-2.18M4 4.44A15.56 15.56 0 0119.56 20h-2.83A12.73 12.73 0 004 7.27V4.44m0 5.66a9.9 9.9 0 019.9 9.9h-2.83A7.07 7.07 0 004 12.93V10.1z"
          ></path>
        </svg>
      </a>
    </div>
    <p>{siteConfig.author} &middot; &copy; {year}</p>
  </div>
</footer>
