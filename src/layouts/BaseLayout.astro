---
import BaseHead from '@/components/BaseHead.astro'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import { adsense, siteConfig } from '@/config'
// Self-hosted so the `font-src 'self'` CSP directive stays as tight as it is today.
import '@fontsource-variable/inter'
import '@/styles/global.css'

interface Props {
  title: string
  description?: string
  canonical?: string
  ogType?: 'website' | 'article'
  publishedAt?: Date
  modifiedAt?: Date
  noindex?: boolean
}

const props = Astro.props
---

<!doctype html>
<html lang={siteConfig.language} class="scroll-smooth">
  <head>
    <BaseHead {...props} />

    {/* Applied before first paint so the theme never flashes. */}
    <script is:inline>
      ;(function () {
        var stored = null
        try {
          stored = localStorage.getItem('theme')
        } catch (error) {
          /* private mode */
        }
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
        if (stored === 'dark' || (stored === null && prefersDark)) {
          document.documentElement.classList.add('dark')
        }
      })()
    </script>

    {
      adsense.enabled && (
        <script
          async
          is:inline
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsense.client}`}
          crossorigin="anonymous"
        />
      )
    }
  </head>

  <body class="flex min-h-screen flex-col font-sans">
    <Header />
    <main class="mx-auto w-full max-w-3xl flex-1 px-4 py-10 sm:px-6">
      <slot />
    </main>
    <Footer />

    <button
      id="scroll-top"
      type="button"
      aria-label="Scroll to top"
      class="fixed right-6 bottom-6 hidden rounded-full bg-gray-200 p-3 text-gray-700 shadow-lg transition hover:bg-gray-300 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700"
    >
      <svg
        class="h-5 w-5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"></path>
      </svg>
    </button>

    <script>
      const button = document.getElementById('scroll-top')
      if (button) {
        const toggle = () => button.classList.toggle('hidden', window.scrollY < 400)
        window.addEventListener('scroll', toggle, { passive: true })
        button.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }))
        toggle()
      }
    </script>
  </body>
</html>
