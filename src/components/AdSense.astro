---
import { adsense } from '@/config'

interface Props {
  class?: string
}

const { class: className = '' } = Astro.props
---

{
  adsense.enabled && (
    <>
      <ins
        class:list={['adsbygoogle', className]}
        style="display:block"
        data-ad-client={adsense.client}
        data-ad-slot={adsense.slot}
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
      <script is:inline>;(window.adsbygoogle = window.adsbygoogle || []).push({})</script>
    </>
  )
}
