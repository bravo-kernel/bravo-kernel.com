---
import type { MarkdownHeading } from 'astro'

interface Props {
  headings: MarkdownHeading[]
  exclude?: string[]
  toHeading?: number
}

const { headings, exclude = [], toHeading = 3 } = Astro.props

const items = headings.filter(
  (heading) => heading.depth >= 2 && heading.depth <= toHeading && !exclude.includes(heading.text),
)
---

{
  items.length > 0 && (
    <nav
      aria-label="Table of contents"
      class="my-8 rounded-lg border border-gray-200 bg-gray-50 p-5 dark:border-gray-700 dark:bg-gray-800/50"
    >
      <ul class="space-y-1.5 text-sm">
        {items.map((heading) => (
          <li style={`margin-left:${(heading.depth - 2) * 1}rem`}>
            <a
              href={`#${heading.slug}`}
              class="text-primary-600 hover:underline dark:text-primary-400"
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
